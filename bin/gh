#!/usr/bin/env bash

set -euo pipefail

real_gh="${IDENTITY_ROUTER_REAL_GH:-/usr/bin/gh}"
token_command="${IDENTITY_ROUTER_TOKEN_COMMAND:-$HOME/.local/bin/multi-account-token}"

if [[ ! -x "$real_gh" ]]; then
  echo "Real gh binary not found at $real_gh" >&2
  exit 127
fi

repo=""
args=("$@")

for ((index = 0; index < ${#args[@]}; index += 1)); do
  case "${args[$index]}" in
    -R|--repo)
      if ((index + 1 >= ${#args[@]})); then
        echo "Missing value for ${args[$index]}" >&2
        exit 2
      fi
      repo="${args[$((index + 1))]}"
      break
      ;;
    --repo=*)
      repo="${args[$index]#--repo=}"
      break
      ;;
  esac
done

token_args=()

if [[ -n "$repo" ]]; then
  token_args=(--repo "$repo")
elif [[ -n "${GH_REPO:-}" ]]; then
  token_args=(--repo "$GH_REPO")
elif remote_url="$(git config --get remote.origin.url 2>/dev/null)" && [[ -n "$remote_url" ]]; then
  token_args=(--remote-url "$remote_url")
fi

# Exit 3 = the owner is identity-only (no credential block): mint nothing and let the
# real gh use whatever credential it would have used without this wrapper.
token_status=0
token="$("$token_command" "${token_args[@]}")" || token_status=$?
if ((token_status == 3)); then
  exec "$real_gh" "$@"
fi
((token_status == 0)) || exit "$token_status"
GH_TOKEN="$token" exec "$real_gh" "$@"
