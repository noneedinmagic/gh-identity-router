#!/usr/bin/env bash

set -euo pipefail

token_command="${IDENTITY_ROUTER_TOKEN_COMMAND:-$HOME/.local/bin/multi-account-token}"
operation="${1:-}"

case "$operation" in
  get)
    protocol=""
    host=""
    path=""

    while IFS='=' read -r key value; do
      case "$key" in
        protocol) protocol="$value" ;;
        host) host="$value" ;;
        path) path="$value" ;;
      esac
    done

    if [[ "$protocol" != "https" || "$host" != "github.com" ]]; then
      exit 0
    fi

    token_args=()
    if [[ -n "$path" ]]; then
      token_args=(--repo "$path" --repo-label "Git credential path")
    fi

    # Exit 3 = no credential, onMissingCredential machine: answer nothing so Git moves on
    # to whatever other credential source applies. Any other failure (blocked, or a
    # credential that failed to mint) answers quit=1: Git then stops instead of asking a
    # later helper or prompting. Git ignores this script's exit code either way.
    token_status=0
    token="$("$token_command" "${token_args[@]}")" || token_status=$?
    if ((token_status == 3)); then
      exit 0
    fi
    if ((token_status != 0)); then
      echo "quit=1"
      exit "$token_status"
    fi
    echo "username=x-access-token"
    echo "password=$token"
    ;;
  store|erase)
    cat >/dev/null || true
    ;;
  *)
    cat >/dev/null || true
    ;;
esac
