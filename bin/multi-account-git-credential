#!/usr/bin/env bash

set -euo pipefail

token_command="${MULTI_ACCOUNT_TOKEN_COMMAND:-$HOME/.local/bin/multi-account-token}"
operation="${1:-}"

case "$operation" in
  get)
    protocol=""
    host=""
    path=""

    while IFS='=' read -r key value; do
      case "$key" in
        protocol) protocol="$value" ;;
        host) host="$value" ;;
        path) path="$value" ;;
      esac
    done

    if [[ "$protocol" != "https" || "$host" != "github.com" ]]; then
      exit 0
    fi

    token_args=()
    if [[ -n "$path" ]]; then
      token_args=(--repo "$path")
    fi

    token="$("$token_command" "${token_args[@]}")"
    echo "username=x-access-token"
    echo "password=$token"
    ;;
  store|erase)
    cat >/dev/null || true
    ;;
  *)
    cat >/dev/null || true
    ;;
esac
